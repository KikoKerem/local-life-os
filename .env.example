# Copy to .env. Everything here is local; no secrets leave the machine.

# --- Vault (your data lives here, git-versioned) ---
# Defaults to ~/local-life-os-vault
# VAULT_PATH=/Users/you/local-life-os-vault

# --- Local web UI / capture server ---
# HOST=127.0.0.1 binds localhost only (most private).
# Set HOST=0.0.0.0 to also reach it from your phone on the same LAN / Tailscale.
HOST=127.0.0.1
PORT=3003

# --- Qwen3.5-9B via MLX (OpenAI-compatible local server) ---
# Start it with:  npm run model    (or: mlx_lm.server --model <model> --port 8080)
LLM_BASE_URL=http://127.0.0.1:8088/v1
LLM_MODEL=mlx-community/Qwen3.5-9B-MLX-4bit
LLM_PORT=8088
# Output token budget for extracted records. 4096 supports 40-80 records per session.
# Real bottleneck is input context (128K window); 16 GB RAM comfortably handles ~20-30K input tokens.
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0

# --- Voice transcription (whisper.cpp, local) ---
# Path to the whisper.cpp CLI binary and a model file. Leave blank to disable voice.
# WHISPER_BIN=/opt/homebrew/bin/whisper-cli
# WHISPER_MODEL=/Users/you/whisper-models/ggml-base.en.bin
WHISPER_LANGUAGE=en

# --- Session ---
# Auto-close a session after this many minutes of silence.
SESSION_IDLE_MINUTES=15
